<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" spacing="12.0" alignment="CENTER" prefWidth="360">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Trim clip" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="10">
        <Label text="Front:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="frontField" text="0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Back:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="backField" text="0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancel" />
        <Button fx:id="acceptButton" text="Accept" />
    </HBox>
</VBox>

